# Copy this file to .env and fill in values from YOUR personal Supabase project
# (Project Settings -> API). Never commit .env.

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Where the React site runs. Add your live URL after deploying, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Any long random string. Used to read the list of interested people.
ADMIN_KEY=change-me-to-a-long-random-string

PORT=4000
